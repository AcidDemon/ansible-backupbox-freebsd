# Managed by Ansible
# --append-only is the first line of defence: a client holding a valid key can
# write new archives but cannot prune or delete existing ones. Host-owned ZFS
# snapshots are the second. `restrict` drops pty, forwarding and agent access.
command="borg serve --append-only --restrict-to-path /backups/{{ client.name }}",restrict {{ client.ssh_key }}
