# Managed by Ansible
# Jail-local sshd. Independent of the host's: hardening_freebsd owns /etc/ssh on
# the host and this jail is deliberately not in its inventory group.
Port 22
PermitRootLogin no
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
UsePAM no
PermitEmptyPasswords no
# Out of the client's repo tree on purpose: that tree is client-writable, and an
# authorized_keys the client can rewrite is not a restriction.
AuthorizedKeysFile /home/%u/.ssh/authorized_keys
{% if _clients | length > 0 %}
AllowUsers {{ _clients | join(' ') }}
{% endif %}
X11Forwarding no
AllowTcpForwarding no
AllowAgentForwarding no
AllowStreamLocalForwarding no
PermitTunnel no
GatewayPorts no
PermitUserEnvironment no
UseDNS no
LoginGraceTime 30
MaxAuthTries 3
# 0, not the host's 300: a borg client blocked on a repo lock goes quiet at the
# SSH layer and would otherwise be cut off mid-transfer.
ClientAliveInterval 0
LogLevel VERBOSE
