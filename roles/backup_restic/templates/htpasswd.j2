# Managed by Ansible
{# Salt derived from the client name so the hash is stable across runs. A random
   salt would rewrite this file and bounce rest-server on every converge. #}
{% for c in _client_rows %}
{{ c.name }}:{{ vault_restic_passwords[c.name] | password_hash('bcrypt', (c.name ~ 'backupbox') | hash('md5') | truncate(22, true, '')) }}
{% endfor %}
