#!/bin/sh
# Managed by Ansible
# Runs on the host, as root, outside the jail.
#
# compact only. borg prune needs the repository passphrase, which the host does
# not have and must not have: these repos are encrypted client-side. So the
# client applies its own retention with prune, which append-only records without
# destroying anything, and the host reclaims the space afterwards. compact is the
# half that works without a key.
#
# The compaction itself runs inside the jail as the client, never as root out
# here. Every compact writes fresh segments under data/ and rewrites index,
# hints and integrity, so a root-side run leaves all of that owned by root - and
# the client, which reaches the repo as an unprivileged jail user, can no longer
# write its own repository. Every backup after that fails.
set -u
log() { logger -t borg-compact "$*"; echo "[borg-compact] $*"; }
ROOT="{{ backup_root }}/{{ backup_borg_jail }}"

# The client chooses its own repository path under its directory, so the client
# directory is usually not itself the repo. Find real repos by their layout: a
# borg repo is a directory holding both a config file and a data directory.
find_borg_repos() {
    find "$1" -maxdepth 3 -type f -name config 2>/dev/null | while read -r cfg; do
        repo=$(dirname "$cfg")
        [ -d "$repo/data" ] && echo "$repo"
    done
}

find_borg_repos "$ROOT" | while read -r repo; do
    # $ROOT/<client>/... on the host is /backups/<client>/... inside the jail,
    # one nullfs mount per client dataset.
    rel=${repo#$ROOT/}
    # Absolute: a root crontab runs with PATH=/usr/bin:/bin, no /usr/sbin.
    /usr/sbin/jexec -l -U "${rel%%/*}" {{ backup_borg_jail }} \
        /usr/local/bin/borg compact "/backups/$rel" || log "$rel: compact rc=$?"
done
log "done"
