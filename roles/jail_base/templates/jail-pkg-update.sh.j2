#!/bin/sh
# Managed by Ansible
# Upgrades packages inside each jail from the host. pkg -r installs into the
# jail root using the host's network, unlike pkg -j, which attaches into the
# jail and would need outbound access these jails deliberately do not have.
# It also means the jail need not be running.
set -u
log() { logger -t jail-pkg-update "$*"; echo "[jail-pkg-update] $*"; }

for j in {% for jail in jails %}{{ jail.name }} {% endfor %}; do
    root="{{ jail_dataset_mount }}/${j}"
    [ -d "$root" ] || { log "$j: no jail root at $root, skipped"; continue; }
    env ASSUME_ALWAYS_YES=yes pkg -r "$root" update -q || log "$j: pkg update rc=$?"
    env ASSUME_ALWAYS_YES=yes pkg -r "$root" upgrade -y || log "$j: pkg upgrade rc=$?"
done
log "done (base userland is updated by re-extracting a new jail_base_version)"
