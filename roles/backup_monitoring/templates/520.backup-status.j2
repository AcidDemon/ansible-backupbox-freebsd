#!/bin/sh
# Managed by Ansible
#
# What this box can check without any client's keys: that data is arriving, and
# that what is on disk is intact. Whether a backup actually RESTORES is the
# client's job - only the client can decrypt it. Neither check substitutes for
# the other.
#
# Note this runs on the inner system. If the box is sitting in the outer base
# awaiting unlock.sh, it does not run at all, which is exactly why the primary
# staleness alarm is client-side healthchecks.io pings, not this script.

set -u
# periodic(8) exit statuses, not shell convention: 1 means "notable information"
# and survives security_show_success=NO, 3 is above the range periodic can mask,
# so a stale or missing backup reaches the mail whatever periodic.conf says.
rc=1
now=$(date +%s)

# Newest snapshot that actually recorded new data. sanoid keeps snapshotting on
# schedule whether or not the client wrote anything, so plain snapshot age would
# never look stale - it would always be under an hour old and always pass.
# `written` is the space a snapshot holds that its predecessor did not.
# The client chooses its own repository path under its directory, so the client
# directory is usually not itself the repo. Find real repos by their layout: a
# borg repo is a directory holding both a config file and a data directory.
find_borg_repos() {
    find "$1" -maxdepth 3 -type f -name config 2>/dev/null | while read -r cfg; do
        repo=$(dirname "$cfg")
        [ -d "$repo/data" ] && echo "$repo"
    done
}

last_change() {
    zfs list -H -p -t snapshot -o creation,written -S creation -r "$1" 2>/dev/null |
        awk '$2 > 0 { print $1; exit }'
}

# A dataset nobody has ever written to is not "fresh", however new its
# snapshots are. The first snapshot of an empty dataset reports `written`
# equal to everything it references - there is no predecessor to diff against
# - so an empty filesystem's own metadata, about 96K, satisfies `written > 0`
# and reads as data having arrived. Every later snapshot correctly reports 0,
# so that first one stays the newest match and the client shows ok for a full
# max_age before it ever goes stale.
#
# Real ingest is orders of magnitude past this floor: borg and restic both
# write a manifest and at least one segment on any backup at all.
has_data() {
    used=$(zfs get -Hp -o value used "$1" 2>/dev/null)
    case "$used" in ''|*[!0-9]*) return 1 ;; esac
    [ "$used" -ge {{ backup_monitoring_empty_bytes }} ]
}

echo "== zpool status =="
zpool status -x {{ backup_pool }}

echo
echo "== per-client freshness =="
{% if backup_clients | length == 0 %}
echo "  no backup clients are configured"
{% endif %}
{% for c in backup_clients %}
{% for svc in c.services %}
ds="{{ backup_pool }}/{{ svc }}/{{ c.name }}"
max_age={{ (c.max_age_hours | default(backup_monitoring_default_max_age_hours)) * 3600 }}
created=$(last_change "$ds")
if ! has_data "$ds"; then
    echo "MISSING  $ds: dataset is empty, no backup has ever arrived"
    rc=3
elif [ -z "$created" ]; then
    echo "MISSING  $ds: no snapshot has ever recorded data (expected until the first sanoid run)"
    rc=3
else
    age=$(( now - created ))
    if [ "$age" -gt "$max_age" ]; then
        printf 'STALE    %s: %sh old (limit %sh)\n' "$ds" "$(( age / 3600 ))" "$(( max_age / 3600 ))"
        rc=3
{% if c.name in (vault_healthchecks | default({})) %}
        fetch -qo /dev/null "{{ vault_healthchecks[c.name] }}/fail" 2>/dev/null || true
{% endif %}
    else
        printf 'ok       %s: %sh old\n' "$ds" "$(( age / 3600 ))"
    fi
fi
{% endfor %}
{% endfor %}

echo
echo "== borg repository integrity =="
# --repository-only checks segment integrity without the repo passphrase, which
# the host does not have and should not have.
found=0
for repo in $(find_borg_repos "{{ backup_root }}/borg"); do
    found=1
    if /usr/local/bin/borg check --repository-only "$repo" 2>&1; then
        echo "ok       $repo"
    else
        echo "FAILED   $repo"
        rc=3
    fi
done
[ "$found" -eq 1 ] || echo "  no borg repositories under {{ backup_root }}/borg"

{% if backup_clients | selectattr('services', 'contains', 'restic') | list | length > 0 %}
echo
echo "== restic append-only =="
# Flags a maintenance window someone forgot to close. The at(1) job should have
# done it, but this is the check that runs whether or not atrun did.
if [ -f "{{ jail_dataset_mount }}/{{ backup_restic_jail | default('restic') }}/usr/local/etc/{{ backup_restic_service | default('restserver') }}.maintenance" ]; then
    echo "OPEN     rest-server is running WITHOUT --append-only"
    rc=3
else
    echo "ok       append-only enforced"
fi
{% endif %}

echo
echo "== restic pack integrity (sample of {{ backup_monitoring_restic_sample }}) =="
# Every restic pack file is named after the SHA256 of its own contents, so this
# verifies real integrity with no repository password involved.
found=0
for repo in {{ backup_root }}/restic/*; do
    [ -d "$repo/data" ] || continue
    found=1
    bad=0
    for f in $(find "$repo/data" -type f | head -n {{ backup_monitoring_restic_sample }}); do
        want=$(basename "$f")
        got=$(sha256 -q "$f")
        [ "$want" = "$got" ] || { echo "CORRUPT  $f"; bad=1; rc=3; }
    done
    if [ "$bad" -eq 0 ]; then
        echo "ok       $repo"
    else
        echo "CORRUPT  $repo"
    fi
done
[ "$found" -eq 1 ] || echo "  no restic repositories under {{ backup_root }}/restic"

exit $rc
