# Managed by Ansible
# Read-only userland shared from the versioned base dataset.
{% for d in jail_instances_ro_dirs %}
{{ jail_dataset_mount }}/base-{{ jail_base }}/{{ d }}	{{ jail_dataset_mount }}/{{ jail.name }}/{{ d }}	nullfs	ro	0	0
{% endfor %}
# One mount per client dataset, not one for the parent. nullfs does not cross
# mount points, so mounting {{ backup_root }}/{{ jail.name }} would expose only that
# dataset's own contents and show each client's dataset as the bare, empty
# directory it is mounted over.
#
# The client data reaches the jail as a plain directory: no ZFS interface, so no
# way to reach or destroy the host's snapshots.
{% for c in backup_clients if jail.name in c.services %}
{{ backup_root }}/{{ jail.name }}/{{ c.name }}	{{ jail_dataset_mount }}/{{ jail.name }}/backups/{{ c.name }}	nullfs	rw	0	0
{% endfor %}
{% if jail.quota is defined %}
# A jail that declares its own quota keeps its own data rather than a client's:
# the service inside it decides the layout, not a client over ssh. Nothing is
# mounted underneath this one, so mounting the parent is safe here in a way the
# per-client tree above is not.
{{ backup_root }}/{{ jail.name }}	{{ jail_dataset_mount }}/{{ jail.name }}/backups	nullfs	rw	0	0
{% endif %}
